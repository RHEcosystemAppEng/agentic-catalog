{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "rh-sre",
  "version": "1.0",
  "description": "Points to all AI skill catalog entities in the rh-sre agentic pack for Red Hat Site Reliability Engineering workflows.\n",
  "author": {
    "name": "Red Hat",
    "email": "agentic-team@redhat.com"
  },
  "homepage": "https://github.com/RHEcosystemAppEng/agentic-catalog.git",
  "repository": "https://github.com/RHEcosystemAppEng/agentic-catalog.git",
  "license": "Apache-2.0",
  "keywords": [
    "ai-skill",
    "sre",
    "monitoring",
    "vulnerability-management"
  ],
  "extensions": {
    "com.anthropic.claude-code": {
      "instructions": "./com.anthropic.claude-code/CLAUDE.md"
    },
    "com.google.gemini-cli": {
      "instructions": "./com.google.gemini-cli/GEMINI.md"
    },
    "ai.opencode": {
      "instructions": "./ai.opencode/AGENTS.md"
    },
    "com.github.copilot": {
      "instructions": "./com.github.copilot/copilot-instructions.md"
    },
    "com.cursor.editor": {
      "instructions": "./com.cursor.editor/rules/rh-sre-instructions.mdc"
    },
    "com.openai.codex": {
      "instructions": "./com.openai.codex/AGENTS.md"
    }
  }
}
