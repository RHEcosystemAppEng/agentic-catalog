    "com.google.gemini-cli": {
      "instructions": "./com.google.gemini-cli/GEMINI.md"
    },
    "ai.opencode": {
      "instructions": "./ai.opencode/AGENTS.md"
    },
    "com.github.copilot": {
      "instructions": "./com.github.copilot/copilot-instructions.md"
    },
    "com.cursor.editor": {
      "instructions": "./com.cursor.editor/rules/rh-basic-instructions.mdc"
    },
    "com.openai.codex": {
      "instructions": "./com.openai.codex/AGENTS.md"
    }
