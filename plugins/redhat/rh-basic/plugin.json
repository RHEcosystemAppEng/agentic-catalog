  "author": {
    "name": "Red Hat",
    "email": "agentic-team@redhat.com"
  },
  "homepage": "https://github.com/RHEcosystemAppEng/agentic-catalog.git",
  "repository": "https://github.com/RHEcosystemAppEng/agentic-catalog.git",
  "license": "Apache-2.0",
  "keywords": [
    "ai-skill",
    "red-hat",
    "getting-started",
    "support"
  ],
  "extensions": {
    "com.anthropic.claude-code": {
      "instructions": "./com.anthropic.claude-code/CLAUDE.md"
